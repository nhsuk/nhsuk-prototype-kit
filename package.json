{
  "name": "your-service-name-goes-here",
  "description": "Rapidly create HTML prototypes of NHS websites and services.",
  "type": "module",
  "main": "app.js",
  "files": [
    "app",
    "app.js",
    "lib",
    "!**/*.test.*"
  ],
  "scripts": {
    "start": "node .",
    "watch": "echo 'run this instead: npm start'",
    "lint": "npm run lint:types && npm run lint:js && npm run lint:css && npm run lint:prettier",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix && npm run lint:prettier:fix",
    "lint:prettier": "prettier --cache --cache-location .cache/prettier --cache-strategy content --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:js": "eslint --cache --cache-location .cache/eslint --cache-strategy content --color .",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint:css": "stylelint --cache --cache-location .cache/stylelint --cache-strategy content --color --formatter verbose --ignore-path .gitignore --max-warnings 0 \"**/*.{md,scss}\"",
    "lint:css:fix": "npm run lint:css -- --fix",
    "lint:types": "tsc --build tsconfig.json --pretty"
  },
  "author": "https://github.com/nhsuk/",
  "license": "MIT",
  "dependencies": {
    "autoprefixer": "^10.5.0",
    "esbuild-sass-plugin": "^3.7.0",
    "express": "^5.2.1",
    "nhsuk-frontend": "^10.6.1",
    "nhsuk-prototype-kit": "^8.5.2",
    "postcss": "^8.5.14"
  },
  "devDependencies": {
    "@eslint/config-helpers": "^0.6.0",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/express": "^5.0.6",
    "@types/express-flash": "^0.0.5",
    "@types/express-session": "^1.19.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-es-x": "^9.6.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-node-import": "^1.2.0",
    "eslint-plugin-promise": "^7.3.0",
    "global": "^4.4.0",
    "globals": "^17.6.0",
    "postcss-markdown": "^1.3.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.3",
    "stylelint": "^16.26.1",
    "stylelint-config-gds": "^2.0.0",
    "stylelint-order": "^8.1.1",
    "typed-query-selector": "^2.12.2",
    "typescript-eslint": "^8.59.3"
  },
  "engines": {
    "node": "^22.11.0 || ^24.11.0"
  }
}
